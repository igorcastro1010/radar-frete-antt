# Exclusivo do servidor. Criar um Blob privado NOVO para este projeto.
BLOB_READ_WRITE_TOKEN=
# OIDC alternativo na Vercel: BLOB_STORE_ID, com o store conectado ao projeto.
BLOB_STORE_ID=
# Segredo aleatório de pelo menos 32 caracteres; também no GitHub Actions.
CRON_SECRET=
APP_ORIGIN=http://localhost:3000
# github-actions ou daily-vercel. Apenas após configurar efetivamente.
SCHEDULER_MODE=github-actions
